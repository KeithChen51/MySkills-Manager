{
  "name": "myskills-manager",
  "private": true,
  "version": "0.1.9",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "sync:tauri-icons": "cargo tauri icon ./skillar-design-pack/logo/skillar-icon-centered-light.png --output ./src-tauri/icons",
    "build:desktop": "npm run sync:tauri-icons && cargo tauri build",
    "build:desktop:windows": "npm run build:desktop && node scripts/expose-skillar-exe.mjs && node scripts/prepare-gitee-package.mjs",
    "build:desktop:windows:update": "node scripts/assert-updater-signing-env.mjs && npm run sync:tauri-icons && cargo tauri build --config src-tauri/tauri.updater.conf.json && node scripts/expose-skillar-exe.mjs && node scripts/prepare-gitee-package.mjs",
    "expose:exe": "node scripts/expose-skillar-exe.mjs",
    "pack:gitee": "node scripts/prepare-gitee-package.mjs",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fontsource/inter": "^5.2.8",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@monaco-editor/react": "^4.7.0",
    "@tauri-apps/api": "^2.10.1",
    "@tauri-apps/plugin-dialog": "^2.4.2",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.10.0",
    "echarts": "^6.0.0",
    "echarts-for-react": "^3.0.6",
    "monaco-editor": "^0.55.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "simple-icons": "^16.9.0",
    "yaml": "^2.8.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "tsx": "^4.21.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^7.3.1"
  }
}
