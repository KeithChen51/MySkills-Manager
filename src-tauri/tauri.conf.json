{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Skillar",
  "version": "0.1.9",
  "identifier": "com.keith.myskillsmanager",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev -- --port 1420 --strictPort",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Skillar - MySkills-Manager",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self' tauri: asset: blob: data: filesystem:; img-src 'self' asset: tauri: blob: data: https:; style-src 'self'; script-src 'self' 'wasm-unsafe-eval'; connect-src 'self' tauri: http://localhost:* http://127.0.0.1:* ws://localhost:* ws://127.0.0.1:* https:; font-src 'self' data: https:;"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": [
      "resources/skillar-vscode.vsix",
      "py"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "headerImage": "icons/installer/nsis-header.bmp",
        "sidebarImage": "icons/installer/nsis-sidebar.bmp"
      }
    }
  },
  "plugins": {
    "updater": {
      "windows": {
        "installMode": "passive"
      },
      "endpoints": [
        "https://github.com/KeithChen51/MySkills-Manager/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDZBMEIyQTAxNjgyQ0M5ODYKUldTR3lTeG9BU29MYW1tTkxaaVFucXBHRDlXT0xEZ2o4dnBWSjNCY0wrZXpQb3VXVW9sMmdmVDYK"
    }
  }
}

