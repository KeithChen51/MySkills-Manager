{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "Functional Evaluation Output",
    "description": "The results of a functional correctness evaluation for a skill.",
    "type": "object",
    "properties": {
        "status": {
            "type": "string",
            "enum": ["success", "error"]
        },
        "skill_name": {
            "type": "string"
        },
        "summary": {
            "type": "object",
            "properties": {
                "total": {"type": "integer"},
                "passed": {"type": "integer"},
                "failed": {"type": "integer"},
                "pass_rate": {"type": "number", "minimum": 0, "maximum": 1}
            },
            "required": ["total", "passed", "failed", "pass_rate"]
        },
        "results": {
            "type": "array",
            "items": {
                "type": "object",
                "properties": {
                    "case_id": {"type": "string"},
                    "passed": {"type": "boolean"},
                    "pass_rate": {"type": "number", "minimum": 0, "maximum": 1},
                    "error": {"type": "string"}
                },
                "required": ["case_id", "passed", "pass_rate"]
            }
        },
        "message": {
            "description": "Error message if status is 'error'",
            "type": "string"
        }
    },
    "required": ["status", "summary", "results"]
}
