  "heading_numbering": {
    "description": "标题编号格式定义",
    "patterns": [
      {
        "level": 1,
        "regex": "^[一二三四五六七八九十]+[、．.]",
        "example": "一、研究背景及意义"
      },
      {
        "level": 2,
        "regex": "^（[一二三四五六七八九十]+）",
        "example": "（一）研究背景"
      },
      {
        "level": 3,
        "regex": "^\\d+[\\.\\.．、]",
        "example": "1. 研究方法"
      },
      {
        "level": 4,
        "regex": "^[\\(（]\\d+[\\)）]",
        "example": "(1) 具体内容"
      }
    ]
  },

