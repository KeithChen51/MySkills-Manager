+
+/* ===== Generating Card (Step 2 AI generation) ===== */
+
+.eval-gen-card {
+  background: linear-gradient(135deg, color-mix(in srgb, var(--primary) 6%, var(--bg-card)) 0%, var(--bg-card) 100%);
+  border: 1px solid color-mix(in srgb, var(--primary) 30%, var(--border-card));
+  border-radius: var(--radius-md, 8px);
+  display: grid;
+  gap: var(--sp-sm);
+  padding: var(--sp-md) var(--sp-lg);
+}
+
+.eval-gen-card-header {
+  align-items: center;
+  display: flex;
+  gap: var(--sp-sm);
+}
+
+.eval-gen-card-icon {
+  animation: eval-gen-spin 2s linear infinite;
+  font-size: 1.3em;
+}
+
+@keyframes eval-gen-spin {
+  from { transform: rotate(0deg); }
+  to { transform: rotate(360deg); }
+}
+
+.eval-gen-card-text {
+  display: flex;
+  flex: 1;
+  flex-direction: column;
+  gap: 2px;
+}
+
+.eval-gen-card-text strong {
+  font-size: var(--text-sm);
+}
+
+.eval-gen-card-text small {
+  color: var(--text-muted);
+  font-size: var(--text-xs);
+}
+
+.eval-gen-card-elapsed {
+  background: color-mix(in srgb, var(--primary) 12%, transparent);
+  border-radius: var(--radius-sm);
+  color: var(--primary);
+  font-size: var(--text-xs);
+  font-variant-numeric: tabular-nums;
+  font-weight: 600;
+  padding: 2px 8px;
+  white-space: nowrap;
+}
+
+.eval-gen-card-bar {
+  background: color-mix(in srgb, var(--primary) 10%, var(--bg-input));
+  border-radius: 4px;
+  height: 4px;
+  overflow: hidden;
+  position: relative;
+}
+
+.eval-gen-card-bar-shimmer {
+  animation: eval-gen-shimmer 1.5s ease-in-out infinite;
+  background: linear-gradient(90deg, transparent 0%, var(--primary) 50%, transparent 100%);
+  border-radius: 4px;
+  height: 100%;
+  opacity: 0.7;
+  position: absolute;
+  width: 40%;
+}
+
+@keyframes eval-gen-shimmer {
+  0% { left: -40%; }
+  100% { left: 100%; }
+}
+
+/* ===== Stage Milestone Bar ===== */
+
+.eval-milestone-bar {
+  align-items: flex-start;
+  display: flex;
+  gap: 0;
+  justify-content: space-between;
+  padding: var(--sp-md) var(--sp-lg);
+  position: relative;
+}
+
+.eval-milestone-line {
+  background: var(--border-card);
+  height: 2px;
+  left: calc(var(--sp-lg) + 16px);
+  position: absolute;
+  right: calc(var(--sp-lg) + 16px);
+  top: calc(var(--sp-md) + 15px);
+  z-index: 0;
+}
+
+.eval-milestone-item {
+  align-items: center;
+  display: flex;
+  flex-direction: column;
+  gap: 6px;
+  position: relative;
+  z-index: 1;
+}
+
+.eval-milestone-circle {
+  align-items: center;
+  background: var(--bg-input);
+  border: 2px solid var(--border-card);
+  border-radius: 50%;
+  color: var(--text-muted);
+  display: flex;
+  font-size: 12px;
+  font-weight: 700;
+  height: 32px;
+  justify-content: center;
+  transition: all 0.3s ease;
+  width: 32px;
+}
+
+.eval-milestone-label {
+  color: var(--text-muted);
+  font-size: var(--text-xs);
+  max-width: 80px;
+  text-align: center;
+  transition: color 0.3s ease;
+  white-space: nowrap;
+}
+
+/* Done state */
+.eval-milestone-done .eval-milestone-circle {
+  background: var(--success, #52c41a);
+  border-color: var(--success, #52c41a);
+  color: #fff;
+}
+
+.eval-milestone-done .eval-milestone-label {
+  color: var(--success, #52c41a);
+  font-weight: 600;
+}
+
+/* Active state */
+.eval-milestone-active .eval-milestone-circle {
+  animation: eval-milestone-pulse 1.8s ease-in-out infinite;
+  background: #3b82f6;
+  border-color: #3b82f6;
+  box-shadow: 0 0 0 4px rgba(59, 130, 246, 0.25);
+  color: #fff;
+}
+
+.eval-milestone-active .eval-milestone-label {
+  color: #3b82f6;
+  font-weight: 600;
+}
+
+@keyframes eval-milestone-pulse {
+  0%, 100% { box-shadow: 0 0 0 4px rgba(59, 130, 246, 0.3); }
+  50% { box-shadow: 0 0 0 8px rgba(59, 130, 246, 0.12); }
+}
+
+.eval-milestone-stats {
+  color: var(--text-muted);
+  font-size: 10px;
+  font-variant-numeric: tabular-nums;
+}
+
+/* ===== Overall Progress Section ===== */
+
+.eval-milestone-progress-section {
+  display: grid;
+  gap: 6px;
+  padding: 0 var(--sp-lg) var(--sp-md);
+}
+
+.eval-milestone-progress-header {
+  align-items: baseline;
+  display: flex;
+  gap: var(--sp-sm);
+  justify-content: space-between;
+}
+
+.eval-milestone-progress-title {
+  font-size: var(--text-sm);
+  font-weight: 600;
+}
+
+.eval-milestone-progress-meta {
+  color: var(--text-muted);
+  font-size: var(--text-xs);
+  font-variant-numeric: tabular-nums;
+}
+
+.eval-milestone-progress-bar {
+  background: color-mix(in srgb, var(--primary) 10%, var(--bg-input));
+  border-radius: 4px;
+  height: 6px;
+  overflow: hidden;
+  position: relative;
+}
+
+.eval-milestone-progress-fill {
+  background: var(--primary);
+  border-radius: 4px;
+  height: 100%;
+}
+
+.eval-milestone-progress-shimmer {
+  animation: eval-gen-shimmer 1.5s ease-in-out infinite;
+  background: linear-gradient(90deg, transparent 0%, var(--primary) 50%, transparent 100%);
+  border-radius: 4px;
+  height: 100%;
+  opacity: 0.5;
+  position: absolute;
+  top: 0;
+  width: 40%;
+}
+
+.eval-milestone-progress-percent {
+  color: var(--text-muted);
+  font-size: var(--text-xs);
+  font-variant-numeric: tabular-nums;
+  font-weight: 600;
+  text-align: right;
+}
+
+/* ===== Case Sub-Progress ===== */
+
+.eval-milestone-case-section {
+  border-top: 1px solid var(--border-card);
+  display: grid;
+  gap: 8px;
+  padding: var(--sp-md) var(--sp-lg);
+}
+
+.eval-milestone-case-header {
+  align-items: baseline;
+  display: flex;
+  gap: var(--sp-sm);
+  justify-content: space-between;
+}
+
+.eval-milestone-case-counter {
+  color: var(--primary);
+  font-size: var(--text-xs);
+  font-variant-numeric: tabular-nums;
+  font-weight: 600;
+}
+
+.eval-milestone-case-bar {
+  height: 4px;
+}
+
+.eval-milestone-case-fill {
+  background: var(--success, #52c41a);
+}
+
+.eval-milestone-case-grid {
+  display: flex;
+  flex-wrap: wrap;
+  gap: 4px;
+  margin-top: 4px;
+}
+
+.eval-milestone-case-dot {
+  border-radius: 3px;
+  height: 10px;
+  transition: background 0.2s ease;
+  width: 10px;
+}
+
+.eval-milestone-case-pass {
+  background: var(--success, #52c41a);
+}
+
+.eval-milestone-case-fail {
+  background: var(--danger, #ff4d4f);
+}
+
+.eval-milestone-case-running {
+  animation: eval-milestone-pulse 1.2s ease-in-out infinite;
+  background: var(--primary);
+}
+
+.eval-milestone-case-pending {
+  background: var(--border-card);
+}
+
+/* ===== Scorecard (.eval-sc-*) ===== */
+
+.eval-sc {
+  background: var(--surface-primary, var(--bg-card));
+  border: 1px solid var(--border-subtle, var(--border-card));
+  border-radius: var(--radius-md, 12px);
+  display: grid;
+  gap: 0;
+  padding: var(--sp-lg);
+}
+
+.eval-sc-header {
+  align-items: center;
+  display: flex;
+  flex-wrap: wrap;
+  gap: var(--sp-md);
+}
+
+/* CSS Stars */
+.eval-sc-stars {
+  display: flex;
+  gap: 2px;
+}
+
+.eval-sc-star {
+  background: color-mix(in srgb, var(--border-card) 60%, transparent);
+  clip-path: polygon(50% 0%, 61% 35%, 98% 35%, 68% 57%, 79% 91%, 50% 70%, 21% 91%, 32% 57%, 2% 35%, 39% 35%);
+  display: inline-block;
+  height: 24px;
+  transition: background 0.25s ease, filter 0.25s ease;
+  width: 24px;
+}
+
+.eval-sc-star-filled {
+  background: linear-gradient(135deg, #fbbf24, #f59e0b);
+  filter: drop-shadow(0 1px 2px rgba(245, 166, 35, 0.35));
+}
+
+.eval-sc-score {
+  font-size: 24px;
+  font-variant-numeric: tabular-nums;
+  font-weight: 700;
+}
+
+.eval-sc-score-max {
+  font-size: var(--text-sm);
+  font-weight: 400;
+  margin-left: 4px;
+  opacity: 0.6;
+}
+
+.eval-sc-score-label {
+  color: var(--text-muted);
+  font-size: var(--text-sm);
+}
+
+/* Confidence warning */
+.eval-sc-warning {
+  background: var(--warning-surface, rgba(250, 173, 20, 0.1));
+  border: 1px solid var(--warning-border, rgba(250, 173, 20, 0.3));
+  border-radius: var(--radius-sm, 6px);
+  color: var(--warning-text, #faad14);
+  font-size: var(--text-xs);
+  margin-top: var(--sp-sm);
+  padding: 6px 12px;
+}
+
+/* Section spacing */
+.eval-sc-section {
+  margin-top: var(--sp-md);
+}
+
+.eval-sc-section-title {
+  font-size: var(--text-sm);
+  font-weight: 600;
+  margin-bottom: 6px;
+}
+
+/* Dimension grid */
+.eval-sc-dim-grid {
+  display: grid;
+  gap: var(--sp-sm);
+  grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
+}
+
+.eval-sc-dim-item {
+  align-items: center;
+  background: var(--surface-secondary, rgba(255, 255, 255, 0.04));
+  border: 1px solid transparent;
+  border-radius: var(--radius-sm, 8px);
+  cursor: default;
+  display: flex;
+  justify-content: space-between;
+  padding: 8px 12px;
+  transition: background 0.2s ease, border-color 0.2s ease;
+}
+
+.eval-sc-dim-item:hover {
+  background: var(--bg-card-hover, rgba(255, 255, 255, 0.08));
+  border-color: var(--border-card);
+}
+
+.eval-sc-dim-label {
+  color: var(--text-secondary);
+  font-size: var(--text-xs);
+}
+
+.eval-sc-dim-score {
+  font-size: 16px;
+  font-variant-numeric: tabular-nums;
+  font-weight: 600;
+}
+
+/* Score colors */
+.eval-sc-good { color: var(--success, #52c41a); }
+.eval-sc-warn { color: var(--warning-text, #faad14); }
+.eval-sc-bad  { color: var(--danger, #ff4d4f); }
+
+/* Comparator grid */
+.eval-sc-comparator-grid {
+  display: grid;
+  font-size: var(--text-xs);
+  gap: 6px;
+  grid-template-columns: repeat(3, 1fr);
+}
+
+.eval-sc-comp-improved {
+  background: color-mix(in srgb, var(--success, #52c41a) 10%, transparent);
+  border-radius: var(--radius-sm, 4px);
+  color: var(--success, #52c41a);
+  padding: 4px 8px;
+}
+
+.eval-sc-comp-regressed {
+  background: color-mix(in srgb, var(--danger, #ff4d4f) 10%, transparent);
+  border-radius: var(--radius-sm, 4px);
+  color: var(--danger, #ff4d4f);
+  padding: 4px 8px;
+}
+
+.eval-sc-comp-unchanged {
+  background: var(--surface-secondary, rgba(255, 255, 255, 0.04));
+  border-radius: var(--radius-sm, 4px);
+  padding: 4px 8px;
+}
+
+.eval-sc-comp-delta {
+  color: var(--text-muted);
+  font-size: var(--text-xs);
+  margin-top: 4px;
+}
+
+/* Analyzer / Suggestions list */
+.eval-sc-list {
+  font-size: var(--text-xs);
+  line-height: 1.6;
+  margin: 0;
+  opacity: 0.85;
+  padding-left: 18px;
+}
+
+/* ===== Result Tabs ===== */
+
+.eval-result-tabs {
+  border-bottom: 1px solid var(--border-card);
+  display: flex;
+  gap: 0;
+  margin-bottom: var(--sp-md);
+}
+
+.eval-result-tab {
+  background: none;
+  border: none;
+  border-bottom: 2px solid transparent;
+  color: var(--text-muted);
+  cursor: pointer;
+  font-size: var(--text-sm);
+  font-weight: 500;
+  padding: var(--sp-sm) var(--sp-md);
+  transition: color 0.2s ease, border-color 0.2s ease;
+}
+
+.eval-result-tab:hover {
+  color: var(--text-primary);
+}
+
+.eval-result-tab-active {
+  border-bottom-color: var(--primary);
+  color: var(--primary);
+  font-weight: 600;
+}
+
+/* ===== Pass / Fail Badges ===== */
+
+.eval-badge-pass,
+.eval-badge-fail {
+  border-radius: 10px;
+  display: inline-block;
+  font-size: var(--text-xs);
+  font-weight: 600;
+  line-height: 1;
+  min-width: 28px;
+  padding: 3px 8px;
+  text-align: center;
+}
+
+.eval-badge-pass {
+  background: color-mix(in srgb, var(--success, #52c41a) 12%, transparent);
+  color: var(--success, #52c41a);
+}
+
+.eval-badge-fail {
+  background: color-mix(in srgb, var(--danger, #ff4d4f) 12%, transparent);
+  color: var(--danger, #ff4d4f);
+}
+
+/* ===== SVG Checkmark in Milestones ===== */
+
+.eval-milestone-check {
+  height: 16px;
+  width: 16px;
+}
+
+/* ===== Global Polish ===== */
+
+.chart-card {
+  transition: box-shadow 0.2s ease, border-color 0.2s ease;
+}
+
+.chart-card:hover {
+  box-shadow: var(--shadow-card-hover, 0 4px 12px rgba(0, 0, 0, 0.08));
+}
+
+.btn {
+  cursor: pointer;
+}
+
+/* ===== Reduced Motion ===== */
+
+@media (prefers-reduced-motion: reduce) {
+  .eval-milestone-active .eval-milestone-circle,
+  .eval-milestone-case-running,
+  .eval-gen-card-icon,
+  .eval-gen-card-bar-shimmer,
+  .eval-milestone-progress-shimmer {
+    animation: none !important;
+  }
+
+  .eval-sc-star,
+  .eval-sc-dim-item,
+  .eval-result-tab,
+  .chart-card {
+    transition: none !important;
+  }
+}
